  "output_directory": "outputs/v2/diagnostics/phase12_robustness_attribution",
  "restrictions": {
    "use_june_for_strategy_selection": false,
    "alter_phase11_frozen_strategy": false,
    "impute_missing_prices": false,
    "impute_missing_forecasts": false,
    "claim_live_executability": false,
    "interpret_post_hoc_june_surface_as_selection": false
