{
  "phase": 12,
  "name": "Robustness, attribution and final empirical synthesis",
  "inputs": {
    "phase11_manifest": "outputs/v2/diagnostics/phase11_frozen_value_gap_trading/phase11_manifest.json",
    "phase11_candidates": "outputs/v2/diagnostics/phase11_frozen_value_gap_trading/phase11_candidate_contract_by_date_rule.csv",
    "phase11_training_grid": "outputs/v2/diagnostics/phase11_frozen_value_gap_trading/phase11_training_threshold_grid.csv",
    "phase11_selection": "outputs/v2/diagnostics/phase11_frozen_value_gap_trading/phase11_frozen_strategy_selection.csv",
    "phase11_performance": "outputs/v2/diagnostics/phase11_frozen_value_gap_trading/phase11_frozen_strategy_performance.csv",
    "phase10_paired_summary": "outputs/v2/diagnostics/phase10_gp_market_comparison/phase10_paired_difference_summary.csv",
    "phase9_score_summary": "outputs/v2/diagnostics/phase9_gp_event_probabilities/phase9_score_summary.csv"
  },
  "sample_periods": {
    "strategy_selection": "weather_plus_market_training",
    "out_of_sample_validation": "out_of_sample_validation",
    "strategy_selection_end": "2026-05-31",
    "out_of_sample_start": "2026-06-01",
    "out_of_sample_end": "2026-06-30"
