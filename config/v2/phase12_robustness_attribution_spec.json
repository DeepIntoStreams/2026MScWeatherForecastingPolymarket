    "maximum_threshold": 0.25,
    "minimum_training_trades": 10,
    "leave_one_date_out": true,
    "temperature_bucket_method": "training-period terciles",
    "fine_cost_minimum": 0.0,
    "fine_cost_maximum": 0.03,
    "fine_cost_increment": 0.0025
  },
  "multiple_strategy_adjustment": {
    "unit": "target_date",
    "bootstrap_repetitions": 10000,
    "bootstrap_seed": 20260728,
    "confidence_level": 0.95,
    "null": "all candidate strategy mean date PnLs are zero",
    "dependence_preservation": "resample dates jointly across all rule-threshold strategies",
    "missing_rule_date_return": 0.0
