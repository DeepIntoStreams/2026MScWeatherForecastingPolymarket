{
  "phase": 10,
  "name": "Exact-common-support GP versus Polymarket comparison",
  "inputs": {
    "phase9_manifest": "outputs/v2/diagnostics/phase9_gp_event_probabilities/phase9_manifest.json",
    "phase9_event_panel": "outputs/v2/diagnostics/phase9_gp_event_probabilities/phase9_gp_contract_event_probability_panel.csv"
  },
  "periods": {
    "weather_plus_market_training_end": "2026-05-31",
    "out_of_sample_validation_start": "2026-06-01",
    "out_of_sample_validation_end": "2026-06-30"
  },
  "decision_rules": [
    "24h_prior",
    "12h_prior",
    "6h_prior",
    "event_day_open"
  ],
  "comparison_design": {
    "support_unit": "complete contract book for one target date and decision rule",
    "binary_market_probability": "raw Polymarket Yes price",
    "categorical_market_probability": "within-book normalised Polymarket Yes price",
    "paired_difference": "GP score minus market score",
    "negative_difference_interpretation": "GP has the lower score",
    "uncertainty_unit": "target_date",
    "bootstrap_repetitions": 10000,
    "bootstrap_seed": 20260728,
    "confidence_level": 0.95,
    "calibration_bins": 10,
    "probability_clip": 1e-12
  },
  "primary_metrics": [
    "binary_brier_raw",
    "binary_log_raw",
    "categorical_log",
    "multiclass_brier"
  ],
  "secondary_metrics": [
    "binary_brier_normalised",
    "binary_log_normalised"
  ],
  "output_directory": "outputs/v2/diagnostics/phase10_gp_market_comparison",
  "restrictions": {
    "refit_gp_model": false,
    "recalibrate_gp_probabilities": false,
    "recalibrate_market_probabilities": false,
    "select_models_using_june": false,
    "impute_missing_market_prices": false,
    "impute_missing_forecasts": false,
    "use_incomplete_contract_books": false,
    "common_support": "exact complete-book intersection"
  }
}
