# Python
__pycache__/
*.pyc
.ipynb_checkpoints/

# Virtual environments
.venv/
venv/
env/

# Environment variables and secrets
.env
.env.*
api_keys.*
credentials*.json
secrets.*

# Raw and processed data
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Outputs
!outputs/.gitkeep

# System files
.DS_Store

# Large files
*.zip
*.tar
*.gz
*.parquet
*.pkl
*.h5
*.nc
*.grib
*.grib2
.virtual_documents/
**/.ipynb_checkpoints/
2026MScWeatherForecastingPolymarket_local_backup_*/
dissertation_notebook_backups/
logs/
scripts/*_backup.py
scripts/*_old_*.py
.pytest_cache/

# Notebook and Python artefacts
*.py[cod]
.mypy_cache/

# Raw and intermediate data remain local unless explicitly admitted
data/interim/*
!data/interim/.gitkeep

# BEGIN CANONICAL OUTPUT POLICY
# Development and external prediction files remain local.
outputs/development/*
!outputs/development/.gitkeep
outputs/external/*
!outputs/external/.gitkeep

# Diagnostic reports supporting integrity checks are versioned.
outputs/diagnostics/*
!outputs/diagnostics/.gitkeep
!outputs/diagnostics/*.json
!outputs/diagnostics/*.csv
!outputs/diagnostics/*.md

# Final thesis tables and figures are versioned.
outputs/final_tables/*
!outputs/final_tables/.gitkeep
!outputs/final_tables/*.csv
!outputs/final_tables/*.tex
!outputs/final_tables/*.json
!outputs/final_tables/*.md
outputs/final_figures/*
!outputs/final_figures/.gitkeep
!outputs/final_figures/*.png
!outputs/final_figures/*.pdf
!outputs/final_figures/*.svg
# END CANONICAL OUTPUT POLICY
